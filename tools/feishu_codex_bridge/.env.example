# Existing credentials are loaded from /home/wjr/.config/feishu-docs/credentials.json.
# Set these values from the Feishu developer console. Both are required.
FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
FEISHU_ENCRYPT_KEY=replace-with-feishu-encrypt-key

# Comma-separated Feishu open_id values. Defaults to the credentials file's
# default_manager_id, and the service refuses to start when empty.
FEISHU_ALLOWED_OPEN_IDS=

# Optional document publishing settings. The editor defaults to the manager
# fields in credentials.json; the bot command grants the actual sender access.
FEISHU_DOC_EDITOR_ID=
FEISHU_DOC_EDITOR_TYPE=openid
FEISHU_DOC_BASE_URL=https://feishu.cn/docx

CODEX_BRIDGE_BIND=127.0.0.1
CODEX_BRIDGE_PORT=8787
CODEX_DEFAULT_WORKSPACE=/data/wjr/vpwem/code_vpwem
CODEX_WORKSPACES_JSON={"vpwem":"/data/wjr/vpwem/code_vpwem","motor":"/home/wjr/code/r435"}
CODEX_MODEL=
