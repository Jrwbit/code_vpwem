[Unit]
Description=Feishu Codex bridge
After=network-online.target

[Service]
Type=simple
User=wjr
WorkingDirectory=/data/wjr/vpwem/code_vpwem
EnvironmentFile=-/data/wjr/vpwem/code_vpwem/tools/feishu_codex_bridge/.env
ExecStart=/usr/bin/python3 /data/wjr/vpwem/code_vpwem/tools/feishu_codex_bridge/long_connection.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
